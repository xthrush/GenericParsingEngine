publish/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# User-specific files
*.rsuser
*.userprefs

# Build logs
msbuild.log
msbuild.err
msbuild.wrn
